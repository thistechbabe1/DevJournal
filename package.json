{
  "name": "dev-journal-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "DevJournal - Modern Full-Stack Developer Journal & Portfolio",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "node scripts/dev.js",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm start --prefix frontend",
    "test": "node scripts/check-no-hardcoded-colors.mjs && npm test --prefix backend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "node scripts/check-no-hardcoded-colors.mjs && npm test --prefix frontend",
    "check:colors": "node scripts/check-no-hardcoded-colors.mjs",
    "check:netlify": "node scripts/verify-netlify-build.mjs",
    "build:frontend": "npm run build --prefix frontend"
  }
}
