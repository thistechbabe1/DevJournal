# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devjournal_dev

# JWT Authentication
JWT_SECRET=your_development_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Frontend CORS Allowed Origins (Comma-separated for multiple URLs)
FRONTEND_URL=http://localhost:4200,https://devjournaal.netlify.app

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Keep-Alive Self-Pinging Service (Render Free Tier Anti-Sleep)
# On Render, RENDER_EXTERNAL_URL is populated automatically by the platform.
# Set BACKEND_URL manually if not on Render (e.g., https://devjournal.onrender.com).
BACKEND_URL=https://devjournal.onrender.com
ENABLE_KEEP_ALIVE=true
PING_INTERVAL_MINUTES=14
